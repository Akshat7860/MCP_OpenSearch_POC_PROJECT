# Groq API key (free -- get one at https://console.groq.com/keys)
GROQ_API_KEY=

# Model used for this POC. openai/gpt-oss-120b is Groq's recommended model
# for reliable tool/function calling. llama-3.3-70b-versatile is a fallback
# if you hit rate limits on the primary model.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# OpenSearch connection (matches docker-compose.yml, security plugin disabled)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9201
OPENSEARCH_USE_SSL=false
